<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.MicroBundleRepository.Core</PackageId>
    <Version>1.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Platform-neutral contracts and immutable content-addressed artifact types for MicroBundle repositories.</Description>
    <PackageTags>microbundle;repository;artifacts;content-addressed;fsm;singularity-workshop</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheSingularityWorkshop.FSM_Serialization" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="images/repository-federation.svg" Pack="true" PackagePath="images/repository-federation.svg" />
  </ItemGroup>

</Project>
