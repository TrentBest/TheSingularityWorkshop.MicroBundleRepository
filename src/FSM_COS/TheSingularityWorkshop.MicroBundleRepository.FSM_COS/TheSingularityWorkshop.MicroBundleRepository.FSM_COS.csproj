<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.MicroBundleRepository.FSM_COS</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>FSM_COS integration adapters for materializing and cataloging MicroBundles from repository artifacts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefineConstants Condition="'$(WorkshopUseRepositorySources)' == 'true'">$(DefineConstants);WORKSHOP_USE_REPOSITORY_SOURCES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WorkshopUseRepositorySources)' != 'true'">
    <PackageReference Include="TheSingularityWorkshop.FSM_COS" Version="0.1.0-alpha.6" />
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../REST/TheSingularityWorkshop.MicroBundleRepository.Rest/TheSingularityWorkshop.MicroBundleRepository.Rest.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <ProjectReference Include="../../../../TheSingularityWorkshop.FSM_COS/src/FSM_COS/FSM_COS.csproj" />
    <ProjectReference Include="../../../../TheSingularityWorkshop.MicroBundleDomain/TheSingularityWorkshop.MicroBundleDomain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>